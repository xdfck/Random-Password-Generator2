# .editorconfig

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
max_line_length = 120

[*.{json,yml,yaml}]
indent_size = 2 # Для JSON часто используют 2 пробела для компактности

[*.md]
trim_trailing_whitespace = false # В Markdown пробелы могут быть важны для форматирования
